# =============================================================================
# API服务配置
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_TITLE="RAG-SearX API"
API_VERSION="1.0.0"
API_DESCRIPTION="AI驱动的多模态书籍知识探索平台"

# =============================================================================
# 向量数据库配置
# =============================================================================
# 支持的类型: milvus, qdrant, chromadb
VECTOR_DB_TYPE=milvus
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=19530
VECTOR_DB_DATABASE=rag_searx
VECTOR_DB_USERNAME=
VECTOR_DB_PASSWORD=

# Milvus特有配置
MILVUS_COLLECTION_NAME=multimodal_collection
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=L2

# Qdrant特有配置
QDRANT_COLLECTION_NAME=multimodal_collection
QDRANT_VECTOR_SIZE=768

# ChromaDB特有配置
CHROMADB_PERSIST_DIRECTORY=./data/chromadb

# =============================================================================
# 大语言模型(LLM)配置
# =============================================================================
# 支持的提供商: openai, anthropic, google, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your_openai_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9

# Anthropic Claude配置
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini配置
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-1.5-pro

# Ollama配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# =============================================================================
# 视觉语言模型(VLM)配置
# =============================================================================
# 支持的提供商: openai, anthropic, google
VLM_PROVIDER=openai
VLM_MODEL=gpt-4o
VLM_API_KEY=your_openai_api_key
VLM_BASE_URL=https://api.openai.com/v1
VLM_MAX_TOKENS=4096

# =============================================================================
# 嵌入模型配置
# =============================================================================
# 支持的提供商: jina, openai, huggingface, sentence_transformers
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v2-base-zh
EMBEDDING_API_KEY=your_jina_api_key
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# OpenAI嵌入配置
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSION=3072

# HuggingFace嵌入配置
HF_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
HF_API_TOKEN=your_huggingface_token

# Sentence Transformers嵌入配置
ST_EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# 多模态嵌入配置
# =============================================================================
# 图像嵌入模型
IMAGE_EMBEDDING_MODEL=clip-ViT-B-32
IMAGE_EMBEDDING_DIMENSION=512

# 视频嵌入模型
VIDEO_EMBEDDING_MODEL=clip-ViT-B-32
VIDEO_EMBEDDING_DIMENSION=512

# =============================================================================
# 检索配置
# =============================================================================
# 初步检索数量
TOP_K_RETRIEVAL=20
# 重排后数量
TOP_K_RERANK=5
# 相似度阈值
SIMILARITY_THRESHOLD=0.7
# 混合检索权重 (向量检索:关键词检索)
HYBRID_SEARCH_ALPHA=0.7
# 启用重排
ENABLE_RERANK=true
# 重排模型
RERANK_MODEL=ms-marco-MiniLM-L-6-v2

# =============================================================================
# 上下文管理配置
# =============================================================================
# 最大上下文长度
MAX_CONTEXT_LENGTH=128000
# 启用上下文压缩
ENABLE_CONTEXT_COMPRESSION=true
# 压缩比例 (0.1-1.0)
COMPRESSION_RATIO=0.5
# 压缩模型
COMPRESSION_MODEL=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank

# =============================================================================
# 文档处理配置
# =============================================================================
# 文本分块大小
TEXT_CHUNK_SIZE=1000
# 文本重叠大小
TEXT_CHUNK_OVERLAP=200
# 章节摘要最大长度
SUMMARY_MAX_LENGTH=500
# 启用语义分块
ENABLE_SEMANTIC_CHUNKING=true

# =============================================================================
# 图像处理配置
# =============================================================================
# 图像描述最大长度
IMAGE_CAPTION_MAX_LENGTH=200
# 图像压缩质量
IMAGE_COMPRESSION_QUALITY=85
# 图像最大尺寸
IMAGE_MAX_SIZE=1024
# 支持的图像格式
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,bmp,gif,webp

# =============================================================================
# 视频处理配置
# =============================================================================
# 视频片段长度(秒)
VIDEO_CLIP_DURATION=30
# 关键帧提取间隔(秒)
KEYFRAME_EXTRACT_INTERVAL=5
# 音频转录语言
AUDIO_TRANSCRIPTION_LANGUAGE=zh
# 支持的视频格式
SUPPORTED_VIDEO_FORMATS=mp4,avi,mov,mkv,wmv

# =============================================================================
# 缓存配置
# =============================================================================
# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_EXPIRE_TIME=3600

# 启用缓存
ENABLE_CACHE=true
CACHE_TYPE=redis  # redis, memory

# =============================================================================
# 数据库配置
# =============================================================================
# SQLite配置
DATABASE_URL=sqlite:///./data/rag_searx.db

# PostgreSQL配置
# DATABASE_URL=postgresql://username:password@localhost/rag_searx

# =============================================================================
# 文件存储配置
# =============================================================================
# 文件存储根目录
FILE_STORAGE_ROOT=./data
# 上传文件最大大小(MB)
MAX_UPLOAD_SIZE=100
# 媒体文件URL前缀
MEDIA_URL_PREFIX=http://localhost:8000/media

# =============================================================================
# 日志配置
# =============================================================================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志文件路径
LOG_FILE=./logs/rag_searx.log
# 日志轮转大小(MB)
LOG_MAX_SIZE=50
# 保留日志文件数量
LOG_BACKUP_COUNT=5

# =============================================================================
# 监控和指标配置
# =============================================================================
# 启用Prometheus指标
ENABLE_METRICS=true
# 指标端口
METRICS_PORT=9090

# =============================================================================
# 安全配置
# =============================================================================
# JWT密钥
JWT_SECRET_KEY=your_jwt_secret_key_change_this_in_production
# JWT过期时间(小时)
JWT_EXPIRE_HOURS=24
# 允许的CORS源
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# 开发和调试配置
# =============================================================================
# 开发模式
DEBUG=false
# 启用API文档
ENABLE_DOCS=true
# 启用详细错误信息
ENABLE_VERBOSE_ERRORS=false

# =============================================================================
# 性能优化配置
# =============================================================================
# 并发处理数量
MAX_CONCURRENT_REQUESTS=10
# 数据库连接池大小
DB_POOL_SIZE=20
# 向量检索批次大小
VECTOR_SEARCH_BATCH_SIZE=100

# =============================================================================
# 实验性功能配置
# =============================================================================
# 启用多模态检索
ENABLE_MULTIMODAL_RETRIEVAL=true
# 启用智能重排
ENABLE_SMART_RERANK=true
# 启用自适应分块
ENABLE_ADAPTIVE_CHUNKING=true 